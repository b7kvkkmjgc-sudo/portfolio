                    <div class="timeline-companies">Merck Group (Merck KGaA, Darmstadt, Germany)<br>Cross-border collaboration · Mission-driven enterprise operations</div>
                </div>
            </div>
        </section>

        <section>
            <h2 class="section-title">Why Novartis</h2>
            <div class="fit-grid">
                <div class="fit-card">
                    <div class="fit-title">Pharma Industry Experience</div>
